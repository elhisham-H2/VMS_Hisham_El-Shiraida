<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VMS - Hisham El-Shiraida</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Student Header Bar: Visible in every screenshot at 100% zoom -->
    <div class="student-bar">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <strong>Student:</strong> Hisham El-Shiraida &nbsp;|&nbsp; 
                <strong>ID:</strong> <span class="badge-highlight">991750966</span>
            </div>
            <div>
                <span class="badge-highlight">PROG30000</span> Enterprise Software Systems &nbsp;|&nbsp; Topic: Vehicle Management System (VMS)
            </div>
        </div>
    </div>

    <!-- Navigation Bar linking to all 5 required pages -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    🚗 <span>VMS Dealership</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Page 1: Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Vehicles" asp-action="Create">Page 2: Add Vehicle</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Vehicles" asp-action="Index">Page 3: All Vehicles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Vehicles" asp-action="Filter">Page 4: Filter by Type</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Vehicles" asp-action="PriceSearch">Page 5: Price Search</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto">
        <div class="container text-center">
            <span>&copy; 2026 - Vehicle Management System (VMS) &bull; Hisham El-Shiraida (#991750966) &bull; Sheridan College PROG30000</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
