@model VMS_Hisham_El_Shiraida.Models.Vehicle

@{
    ViewData["Title"] = "Page 2: Add Vehicle";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-title">Page 2: Add a Vehicle</h1>
        <p class="page-subtitle">Enter details below to add a new vehicle to inventory.</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Index" class="back-home-link">
            &larr; Back to Home
        </a>
    </div>
</div>

<div class="card card-custom form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

        <div class="mb-3">
            <label asp-for="Make" class="form-label"></label>
            <input asp-for="Make" class="form-control" placeholder="e.g. Ford, Toyota, BMW" />
            <span asp-validation-for="Make" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<VMS_Hisham_El_Shiraida.Models.VehicleType>()">
                <option value="">-- Select Vehicle Type --</option>
            </select>
            <span asp-validation-for="Type" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PurchaseDate" class="form-label"></label>
            <input asp-for="PurchaseDate" type="date" class="form-control" />
            <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Year" class="form-label"></label>
            <input asp-for="Year" type="number" min="1990" max="2027" class="form-control" placeholder="e.g. 2024" />
            <span asp-validation-for="Year" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="Price" type="number" step="0.01" min="1" max="500000" class="form-control" placeholder="e.g. 34999.00" />
            </div>
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>
            <button type="submit" class="btn btn-primary px-4">
                ➕ Create Vehicle
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
