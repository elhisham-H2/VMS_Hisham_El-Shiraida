@model VMS_Hisham_El_Shiraida.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-title text-danger">Delete Vehicle</h1>
        <p class="page-subtitle">Are you sure you want to permanently delete this vehicle from inventory?</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Index" class="back-home-link">
            &larr; Back to Home
        </a>
    </div>
</div>

<div class="card card-custom form-card border-danger">
    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
        <div>
            ⚠️ <strong>Warning:</strong> This action cannot be undone. Please confirm you wish to remove this record.
        </div>
    </div>

    <dl class="row mb-0 gy-2">
        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.VehicleId)</dt>
        <dd class="col-sm-8 fw-bold">#@Model.VehicleId</dd>

        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Make)</dt>
        <dd class="col-sm-8">@Model.Make</dd>

        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Type)</dt>
        <dd class="col-sm-8">@Model.Type</dd>

        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.PurchaseDate)</dt>
        <dd class="col-sm-8">@Model.PurchaseDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Year)</dt>
        <dd class="col-sm-8">@Model.Year</dd>

        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-8 fw-bold text-danger">@Model.Price.ToString("C")</dd>
    </dl>

    <form asp-action="Delete" method="post" class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
        <input type="hidden" asp-for="VehicleId" />
        <a asp-action="Index" class="btn btn-outline-secondary">
            Cancel &amp; Back to List
        </a>
        <button type="submit" class="btn btn-danger px-4">
            🗑️ Confirm Delete
        </button>
    </form>
</div>
