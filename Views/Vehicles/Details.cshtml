@model VMS_Hisham_El_Shiraida.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
    var badgeClass = Model.Type switch
    {
        VMS_Hisham_El_Shiraida.Models.VehicleType.Truck => "badge-type-truck",
        VMS_Hisham_El_Shiraida.Models.VehicleType.Sedan => "badge-type-sedan",
        VMS_Hisham_El_Shiraida.Models.VehicleType.Van => "badge-type-van",
        VMS_Hisham_El_Shiraida.Models.VehicleType.SUV => "badge-type-suv",
        VMS_Hisham_El_Shiraida.Models.VehicleType.Coupe => "badge-type-coupe",
        _ => "bg-secondary text-white"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-title">Vehicle Details</h1>
        <p class="page-subtitle">Full inventory record for #@Model.VehicleId - @Model.Make</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Index" class="back-home-link">
            &larr; Back to Home
        </a>
    </div>
</div>

<div class="card card-custom form-card">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h4 class="m-0 text-primary fw-bold">@Model.Make</h4>
        <span class="badge-pill-custom @badgeClass">@Model.Type</span>
    </div>

    <dl class="row mb-0 gy-2">
        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.VehicleId)</dt>
        <dd class="col-sm-8 fw-semibold">#@Model.VehicleId</dd>

        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Make)</dt>
        <dd class="col-sm-8">@Model.Make</dd>

        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Type)</dt>
        <dd class="col-sm-8">@Model.Type</dd>

        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.PurchaseDate)</dt>
        <dd class="col-sm-8">@Model.PurchaseDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Year)</dt>
        <dd class="col-sm-8">@Model.Year</dd>

        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-8 fw-bold text-success fs-5">@Model.Price.ToString("C")</dd>
    </dl>

    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to List
        </a>
        <a asp-action="Edit" asp-route-id="@Model.VehicleId" class="btn btn-primary px-4">
            ✏️ Edit Vehicle
        </a>
    </div>
</div>
